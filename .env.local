# ==============================================================================
# IPO KING - Environment Configuration File (.env.local)
#
#   Works for:
#     🔵 Local Development (Windows/Mac/Linux)
#     🟢 Vercel Production / Preview Deployments
#
#   The email system uses a 4-tier delivery waterfall:
#     1. Resend HTTPS API (port 443 - NEVER blocked; 100% works on Vercel)
#     2. Generic SMTP (Gmail / Outlook / Zoho / SendGrid / etc.)
#     3. Direct MX transport (deliver straight to recipient's mail server)
#     4. Ethereal.email preview (dev-only; renders email at a preview URL)
#
#   RECOMMENDATION:
#     → For VERCEL:       Set RESEND_API_KEY (Resend is made by Vercel team)
#     → For LOCAL ONLY:   Set Gmail SMTP vars. Google Account → Security →
#                         2-Step Verification ON → App passwords → Create one
# ==============================================================================

# ---------------------------------------------------------------------------
# 1. RESEND (VERCEL RECOMMENDED)  -  https://resend.com/  -  3,000 emails/mo free
#    ✅ Port 443 HTTPS - never firewalled
#    ✅ Works on Vercel, Netlify, Cloudflare, Railway, Render, local... everywhere
#    ✅ SPF / DKIM / DMARC pre-configured → inbox (not spam)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Optional: Once you add & verify a sending domain:
# RESEND_FROM_EMAIL="IPO KING Auth <noreply@your-verified-domain.com>"

# ---------------------------------------------------------------------------
# 2. SMTP CREDENTIALS (Gmail App Password example)
#    Create a Google App Password here (requires 2FA enabled first):
#    https://myaccount.google.com/apppasswords
#    NOTE: Google App Passwords are 16 chars, shown as 4 groups separated by
#    spaces - e.g. "abcd efgh ijkl mnop". You may paste the spaces in; the
#    code will strip them automatically.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=swiggy.servicess@gmail.com
SMTP_PASS= yhiq tlvi clco feyz
SMTP_FROM_NAME=IPO KING Auth

# ---------------------------------------------------------------------------
# 3. SUPABASE DATABASE CREDENTIALS (FREE Cloud Database)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://munohtnnfozpznsawbvn.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_-tWiLxohizYZLb3Ckz5t1w_TU1iIYGZ
# ---------------------------------------------------------------------------
# 4. BACKEND API SERVER (local only; not used on Vercel)
# ---------------------------------------------------------------------------
PORT=5000
JWT_SECRET=ipoking_enterprise_secret_key_2026
