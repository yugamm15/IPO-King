# ==============================================================================
# IPO KING - Environment Configuration Template (.env.example)
# Rename or copy this file to `.env.local` for local development.
# DO NOT commit real secrets or passwords to Git.
# ==============================================================================

# 1. RESEND API (HTTPS API - Recommended for Vercel)
RESEND_API_KEY=

# 2. SMTP CREDENTIALS (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM_NAME=IPO KING Auth

# 3. SUPABASE DATABASE CREDENTIALS
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 4. BACKEND API SERVER
PORT=5000
JWT_SECRET=your_jwt_secret_key
