# ==============================================================================
# IPO KING - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development or set in Vercel Dashboard
# ==============================================================================

# --- SUPABASE CONFIGURATION ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# --- ADMIN AUTHENTICATION & JWT SECURITY ---
# Secure random 256-bit key used to sign Express JWT access & refresh tokens
JWT_SECRET=generate_a_secure_random_64_char_hex_string_here

# Admin Login Credentials for 2FA Authentication
AUTH_ADMIN_EMAIL=your_admin_email@example.com
AUTH_ADMIN_PASSWORD=YourSecureAdminPassword!2026
AUTH_ADMIN_NAME="IPO KING Administrator"

# --- 2FA EMAIL DELIVERY (RESEND / SMTP) ---
# Primary: Resend HTTPS API (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Secondary: Custom SMTP Fallback (e.g. Gmail App Password, AWS SES, Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="IPO KING Security <no-reply@ipoking.com>"

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=production
